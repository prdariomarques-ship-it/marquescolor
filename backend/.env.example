# Copy to .env (same directory) and fill in. Never commit the real .env.

# Postgres — this stack runs its OWN Postgres container
# (docker-compose.backend.yml), never the DarioOS project's Postgres.
# These three are consumed by docker-compose.backend.yml directly; when
# running the app outside Compose (e.g. local dev), set DATABASE_URL
# yourself instead.
MARQUESCOLOR_DB_USER=marquescolor
MARQUESCOLOR_DB_PASSWORD=change-me
MARQUESCOLOR_DB_NAME=marquescolor
DATABASE_URL=postgresql+psycopg://marquescolor:change-me@localhost:5432/marquescolor

# IMAP mailbox this service reads. Must be an app password / dedicated
# credential, not the account's normal login password — Outlook requires
# an app password when 2FA is enabled, and even without 2FA a dedicated
# credential is safer to rotate/revoke independently of the mailbox owner's
# own login.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=marquescolor@outlook.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Where successfully-ingested messages get copied (never moved/deleted —
# the original always stays in INBOX, marked \Seen). Create this folder in
# Outlook first; if it doesn't exist, ingestion still succeeds, just skips
# the copy (logged, not fatal).
IMAP_PROCESSED_MAILBOX=Processado

POLL_INTERVAL_SECONDS=300

# Master switch — the worker process idles and never touches the mailbox
# while this is false. Keep false until a real mailbox + credentials are
# configured and reviewed.
INGEST_ENABLED=false

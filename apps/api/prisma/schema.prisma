// Marquescollor Tintas - schema Prisma COMPLETO (20 modelos) com @relation
// Etapa B2 adiciona RefreshToken. Modulos restantes implementados em B3-B16.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String    @id @default(cuid())
  nome            String
  login           String    @unique
  senhaHash       String
  papel           String    @default("VENDEDOR") // ADMIN | GERENTE | VENDEDOR | CAIXA
  ativo           Boolean   @default(true)
  deveTrocarSenha Boolean   @default(true)
  ultimoLogin     DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([papel])
  @@index([ativo])
}

model RefreshToken {
  id          String   @id @default(cuid())
  usuarioId   String
  token       String   @unique
  expiraEm    DateTime
  revogado    Boolean  @default(false)
  criadoEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([token])
  @@index([expiraEm])
}

model Auditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  acao        String
  entidade    String
  entidadeId  String?
  dadosAntes  String?
  dadosDepois String?
  ip          String?
  criadoEm    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId])
}

model Categoria {
  id           String   @id @default(cuid())
  nome         String   @unique
  corHex       String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos Produto[]
}

model Marca {
  id           String   @id @default(cuid())
  nome         String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  produtos Produto[]
}

model Produto {
  id                     String   @id @default(cuid())
  codigoInterno          String   @unique
  codigoBarras           String?  @unique
  nome                   String
  descricao              String?
  marcaId                String?
  categoriaId            String?
  subcategoria           String?
  unidade                String   @default("UN")
  cor                    String?
  acabamento             String?
  volume                 String?
  precoCustoCentavos     Int      @default(0)
  precoVendaCentavos     Int      @default(0)
  margemPercentual       Float    @default(0)
  estoqueAtual           Float    @default(0)
  estoqueMinimo          Float    @default(0)
  estoqueMaximo          Float    @default(0)
  localizacao            String?
  fornecedorPrincipalId  String?
  fotoUrl                String?
  ncm                    String?
  cest                   String?
  cfop                   String?
  cstCsosn               String?
  origem                 Int?     @default(0)
  unidadeTributavel      String?
  ativo                  Boolean  @default(true)
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  marca          Marca?              @relation(fields: [marcaId], references: [id])
  categoria      Categoria?          @relation(fields: [categoriaId], references: [id])
  movimentacoes  MovimentacaoEstoque[]
  itensVenda     ItemVenda[]
  itensCompra    ItemCompra[]
  itensOrcamento ItemOrcamento[]
  nfeItens       NfeItem[]
  fornecedorMaps ProdutoFornecedorMap[]

  @@index([marcaId])
  @@index([categoriaId])
  @@index([ativo])
}

model MovimentacaoEstoque {
  id             String   @id @default(cuid())
  produtoId      String
  tipo           String
  quantidade     Float
  saldoAnterior  Float
  saldoPosterior Float
  motivo         String?
  documentoRef   String?
  usuarioId      String?
  criadoEm       DateTime @default(now())

  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
  @@index([tipo])
}

model Cliente {
  id                    String   @id @default(cuid())
  nome                  String
  cpfCnpj               String?  @unique
  telefone              String?
  whatsapp              String?
  email                 String?
  cep                   String?
  endereco              String?
  numero                String?
  complemento           String?
  bairro                String?
  cidade                String?
  uf                    String?
  observacoes           String?
  limiteCreditoCentavos Int      @default(0)
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  vendas        Venda[]
  orcamentos    Orcamento[]
  contasReceber ContaReceber[]

  @@index([nome])
  @@index([ativo])
}

model Fornecedor {
  id           String   @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String?  @unique
  telefone     String?
  whatsapp     String?
  email        String?
  cep          String?
  endereco     String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  uf           String?
  contato      String?
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  compras     Compra[]
  contasPagar ContaPagar[]
  nfeDocumentos NfeDocument[]
  produtoMaps   ProdutoFornecedorMap[]

  @@index([razaoSocial])
  @@index([ativo])
}

model Venda {
  id                 String    @id @default(cuid())
  numero             Int       @unique
  status             String    @default("RASCUNHO")
  clienteId          String?
  usuarioId          String
  caixaId            String?
  subtotalCentavos   Int       @default(0)
  descontoCentavos   Int       @default(0)
  acrescimoCentavos  Int       @default(0)
  totalCentavos      Int       @default(0)
  canceladaEm        DateTime?
  canceladaPorId     String?
  motivoCancelamento String?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  cliente    Cliente?        @relation(fields: [clienteId], references: [id])
  itens      ItemVenda[]
  pagamentos PagamentoVenda[]

  @@index([status])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([caixaId])
}

model ItemVenda {
  id                    String   @id @default(cuid())
  vendaId               String
  produtoId             String
  quantidade            Float
  precoUnitarioCentavos Int
  custoUnitarioCentavos Int?
  descontoItemCentavos  Int      @default(0)
  subtotalCentavos      Int
  nomeProdutoSnapshot   String
  codigoSnapshot        String
  criadoEm              DateTime @default(now())

  venda   Venda   @relation(fields: [vendaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([vendaId])
  @@index([produtoId])
}

model PagamentoVenda {
  id            String   @id @default(cuid())
  vendaId       String
  forma         String
  valorCentavos Int
  parcelas      Int      @default(1)
  bandeira      String?
  observacao    String?
  criadoEm      DateTime @default(now())

  venda Venda @relation(fields: [vendaId], references: [id])

  @@index([vendaId])
  @@index([forma])
}

model CaixaSessao {
  id                              String    @id @default(cuid())
  usuarioAberturaId               String
  usuarioFechamentoId             String?
  abertoEm                        DateTime  @default(now())
  fechadoEm                       DateTime?
  status                          String    @default("ABERTO")
  valorAberturaCentavos           Int       @default(0)
  valorFechamentoInformadoCentavos Int?
  valorFechamentoEsperadoCentavos Int?
  diferencaCentavos               Int?
  observacao                      String?

  movimentacoes MovimentacaoCaixa[]

  @@index([status])
}

model MovimentacaoCaixa {
  id            String   @id @default(cuid())
  caixaId       String
  tipo          String
  valorCentavos Int
  descricao     String?
  usuarioId     String?
  criadoEm      DateTime @default(now())

  caixa CaixaSessao @relation(fields: [caixaId], references: [id])

  @@index([caixaId])
  @@index([tipo])
}

model Compra {
  id               String   @id @default(cuid())
  fornecedorId     String
  numeroPedido     String?
  dataCompra       DateTime @default(now())
  subtotalCentavos Int      @default(0)
  descontoCentavos Int      @default(0)
  freteCentavos    Int      @default(0)
  totalCentavos    Int      @default(0)
  formaPagamento   String?
  observacoes      String?
  usuarioId        String
  status           String   @default("RASCUNHO")
  criadoEm         DateTime @default(now())

  fornecedor Fornecedor  @relation(fields: [fornecedorId], references: [id])
  itens      ItemCompra[]

  @@index([fornecedorId])
  @@index([status])
}

model ItemCompra {
  id                 String   @id @default(cuid())
  compraId           String
  produtoId          String
  quantidade         Float
  precoCustoCentavos Int
  subtotalCentavos   Int

  compra  Compra  @relation(fields: [compraId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([compraId])
  @@index([produtoId])
}

model Orcamento {
  id               String    @id @default(cuid())
  numero           Int       @unique
  clienteId        String?
  usuarioId        String
  validade         DateTime?
  status           String    @default("ABERTO")
  subtotalCentavos Int       @default(0)
  descontoCentavos Int       @default(0)
  totalCentavos    Int       @default(0)
  observacoes      String?
  criadoEm         DateTime  @default(now())

  cliente Cliente?       @relation(fields: [clienteId], references: [id])
  itens   ItemOrcamento[]

  @@index([status])
  @@index([clienteId])
}

model ItemOrcamento {
  id                    String   @id @default(cuid())
  orcamentoId           String
  produtoId             String
  quantidade            Float
  precoUnitarioCentavos Int
  descontoItemCentavos  Int      @default(0)
  subtotalCentavos      Int

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@index([orcamentoId])
  @@index([produtoId])
}

model ContaReceber {
  id                String    @id @default(cuid())
  clienteId         String?
  vendaId           String?
  descricao         String
  valorCentavos     Int
  vencimento        DateTime
  pagoEm            DateTime?
  valorPagoCentavos Int?
  status            String    @default("PENDENTE")
  formaPagamento    String?
  criadoEm          DateTime  @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@index([status])
  @@index([clienteId])
  @@index([vencimento])
}

model ContaPagar {
  id                String    @id @default(cuid())
  fornecedorId      String?
  compraId          String?
  descricao         String
  valorCentavos     Int
  vencimento        DateTime
  pagoEm            DateTime?
  valorPagoCentavos Int?
  status            String    @default("PENDENTE")
  formaPagamento    String?
  criadoEm          DateTime  @default(now())

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@index([status])
  @@index([fornecedorId])
  @@index([vencimento])
}

model Configuracao {
  id                      String  @id @default("unica")
  nomeLoja                String  @default("Marquescollor Tintas")
  cnpj                    String?
  inscricaoEstadual       String?
  endereco                String?
  telefone                String?
  whatsapp                String?
  logoUrl                 String?
  proximoNumeroVenda      Int     @default(1)
  permitirVendaSemEstoque Boolean @default(true)
  impressoraNome          String?
  larguraCupomMm          Int     @default(80)
  imprimirAuto            Boolean @default(false)
  cabecalhoCupom          String?
  rodapeCupom             String?
  mensagemFinal           String?
  formasPagamentoAtivas   String?
}

model MetaMensal {
  id                String   @id @default(cuid())
  competencia       String   @unique // YYYY-MM
  valorMetaCentavos Int
  cenario           String   @default("manual")
  origem            String   @default("MANUAL")
  atualizadoPorId   String?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@index([competencia])
}

// ============================================================================
// FASE 5 - Inteligencia documental / NF-e (ADITIVO: nenhuma tabela existente e
// alterada; apenas back-relations em Fornecedor e Produto).
// Etapas SEPARADAS (nao misturar): documento recebido -> interpretado ->
// conferido -> compra preparada -> compra aprovada -> mercadoria recebida
// fisicamente -> estoque atualizado. "Custo atualizado" e "preco aprovado" NAO
// sao definidos por este modulo (ver docs/integrations/nfe-pricing-contract.md).
// Valores monetarios em centavos (Int). Sem JSON nativo no SQLite: JSON em String.
// ============================================================================

model EmailMensagem {
  id            String    @id @default(cuid())
  messageId     String    @unique // Message-ID; sem header => "sha256:<hash dos bytes brutos>" (deterministico)
  conta         String? // rotulo da caixa (NUNCA credenciais)
  remetente     String
  remetenteNome String?
  destinatario  String?
  assunto       String?
  recebidoEm    DateTime
  categoria     String    @default("DESCONHECIDO")
  confianca     Float     @default(0)
  status        String    @default("RECEBIDO") // RECEBIDO | PROCESSADO | REVISAO_HUMANA | ERRO
  erro          String?
  origemHandle  String? // identificador opaco na caixa (ex.: UID IMAP)
  criadoEm      DateTime  @default(now())
  processadoEm  DateTime?

  arquivos   DocumentoArquivo[]
  documentos NfeDocument[]

  @@index([status])
  @@index([categoria])
}

model DocumentoArquivo {
  id             String   @id @default(cuid())
  emailId        String?
  origem         String // EMAIL | UPLOAD
  nomeOriginal   String
  mimeType       String
  tamanhoBytes   Int
  sha256         String   @unique // duplicidade de anexo/arquivo
  caminho        String // relativo a NFE_STORAGE_DIR; arquivo ORIGINAL preservado
  tipoDetectado  String // XML_NFE | PDF_TEXTO | PDF_ESCANEADO | IMAGEM | OUTRO
  status         String   @default("RECEBIDO") // RECEBIDO | INTERPRETADO | SEM_DADOS | FALHA
  metodoExtracao String? // XML | PDF_TEXTO | OCR
  erro           String?
  usuarioId      String?
  criadoEm       DateTime @default(now())

  email      EmailMensagem? @relation(fields: [emailId], references: [id])
  documentos NfeDocument[]

  @@index([emailId])
  @@index([status])
}

model NfeDocument {
  id                     String    @id @default(cuid())
  arquivoId              String?
  emailId                String?
  chaveAcesso            String?   @unique
  chaveValida            Boolean   @default(false) // 44 digitos + DV modulo 11 + coerencia
  modelo                 String?
  serie                  String?
  numero                 String?
  naturezaOperacao       String?
  dataEmissao            DateTime?
  emitenteCnpj           String?
  emitenteNome           String?
  emitenteFantasia       String?
  emitenteIe             String?
  emitenteCrt            String?
  emitenteUf             String?
  destinatarioCnpj       String?
  destinatarioNome       String?
  fornecedorId           String?
  valorProdutosCentavos  Int       @default(0)
  valorFreteCentavos     Int       @default(0)
  valorSeguroCentavos    Int       @default(0)
  valorDescontoCentavos  Int       @default(0)
  valorOutrasCentavos    Int       @default(0)
  valorIcmsCentavos      Int       @default(0)
  valorIcmsStCentavos    Int       @default(0)
  valorIpiCentavos       Int       @default(0)
  valorPisCentavos       Int       @default(0)
  valorCofinsCentavos    Int       @default(0)
  valorTotalCentavos     Int       @default(0)
  pagamentoJson          String? // formas de pagamento + duplicatas (vencimentos)
  protocoloAutorizacao   String? // nProt do protNFe (NAO e validacao SEFAZ)
  fonteDados             String // XML | PDF_TEXTO | OCR
  origemCamposJson       String? // campo -> fonte/trecho de onde veio
  confianca              Float     @default(0)
  // Etapas separadas
  statusDocumento        String    @default("INTERPRETADO") // INTERPRETADO | FALHA_INTERPRETACAO
  statusConferencia      String    @default("PENDENTE") // PENDENTE | EM_REVISAO | CONFERIDA | REJEITADA
  statusCompra           String    @default("NAO_PREPARADA") // NAO_PREPARADA | PREPARADA | APROVADA
  statusEstoque          String    @default("NAO_APLICADO") // NAO_APLICADO | APLICADO | FALHA
  compraId               String? // Compra criada na aprovacao (sem efeito em estoque/custo)
  aprovadoPorId          String?
  aprovadoEm             DateTime?
  rejeitadoPorId         String?
  rejeitadoEm            DateTime?
  recebimentoFisicoPorId String?
  recebimentoFisicoEm    DateTime?
  estoqueAtualizadoEm    DateTime?
  criadoEm               DateTime  @default(now())
  atualizadoEm           DateTime  @updatedAt

  arquivo    DocumentoArquivo? @relation(fields: [arquivoId], references: [id])
  email      EmailMensagem?    @relation(fields: [emailId], references: [id])
  fornecedor Fornecedor?       @relation(fields: [fornecedorId], references: [id])
  itens      NfeItem[]

  @@unique([emitenteCnpj, modelo, serie, numero])
  @@index([statusConferencia])
  @@index([statusCompra])
  @@index([fornecedorId])
}

model NfeItem {
  id                    String   @id @default(cuid())
  documentoId           String
  numeroItem            Int
  codigoFornecedor      String? // cProd (texto: preserva zeros a esquerda)
  gtin                  String? // cEAN (nulo para SEM GTIN)
  descricao             String?
  ncm                   String?
  cest                  String?
  cfop                  String?
  origemMercadoria      String? // orig
  cst                   String? // CST (regime normal)
  csosn                 String? // CSOSN (Simples Nacional)
  unidade               String? // uCom
  unidadeTributavel     String? // uTrib
  quantidadeOriginal    String // qCom exatamente como veio
  quantidade            Float
  valorUnitarioOriginal String // vUnCom exatamente como veio (ate 10 casas)
  valorUnitarioCentavos Int // arredondado (informativo; o total fiscal e valorTotalCentavos)
  valorTotalCentavos    Int // vProd
  freteCentavos         Int      @default(0)
  seguroCentavos        Int      @default(0)
  descontoCentavos      Int      @default(0)
  outrasCentavos        Int      @default(0)
  icmsCentavos          Int      @default(0)
  icmsStCentavos        Int      @default(0)
  ipiCentavos           Int      @default(0)
  pisCentavos           Int      @default(0)
  cofinsCentavos        Int      @default(0)
  impostosJson          String? // nos de imposto ORIGINAIS (preservados)
  origemDados           String // XML | PDF_TEXTO | OCR
  produtoId             String?
  statusVinculo         String   @default("SEM_CORRESPONDENCIA") // MAPEADO | SUGERIDO | CONFIRMADO | SEM_CORRESPONDENCIA | DISPENSADO
  vinculoOrigem         String? // MAPA_FORNECEDOR | GTIN | HUMANO
  vinculoPorId          String?
  quantidadeRecebida    Float?
  movimentacaoEstoqueId String?  @unique // idempotencia da entrada em estoque
  criadoEm              DateTime @default(now())

  documento NfeDocument @relation(fields: [documentoId], references: [id])
  produto   Produto?    @relation(fields: [produtoId], references: [id])

  @@unique([documentoId, numeroItem])
  @@index([produtoId])
}

// Mapa codigo-do-fornecedor -> produto interno. UNICO sinal automatico confiavel.
// So e criado por decisao HUMANA (nunca por fuzzy/IA).
model ProdutoFornecedorMap {
  id               String   @id @default(cuid())
  fornecedorId     String
  codigoFornecedor String
  produtoId        String
  criadoPorId      String?
  criadoEm         DateTime @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  produto    Produto    @relation(fields: [produtoId], references: [id])

  @@unique([fornecedorId, codigoFornecedor])
  @@index([produtoId])
}

model ReviewQueueItem {
  id             String    @id @default(cuid())
  documentoId    String?
  entidadeTipo   String // EMAIL | ARQUIVO | NFE | NFE_ITEM
  entidadeId     String
  motivo         String
  ref            String    @default("") // diferencia varios itens do mesmo motivo (idempotencia)
  severidade     String    @default("BLOQUEANTE") // BLOQUEANTE | ALERTA
  detalhe        String?
  dadosJson      String?
  status         String    @default("ABERTO") // ABERTO | RESOLVIDO | DISPENSADO
  resolucao      String?
  resolvidoPorId String?
  resolvidoEm    DateTime?
  criadoEm       DateTime  @default(now())

  @@unique([entidadeTipo, entidadeId, motivo, ref])
  @@index([status])
  @@index([documentoId])
}

model ProcessingLog {
  id            String   @id @default(cuid())
  correlationId String
  entidadeTipo  String
  entidadeId    String?
  acao          String
  status        String // OK | WARN | ERROR
  mensagem      String?
  detalheJson   String?
  usuarioId     String?
  criadoEm      DateTime @default(now())

  @@index([entidadeTipo, entidadeId])
  @@index([correlationId])
}

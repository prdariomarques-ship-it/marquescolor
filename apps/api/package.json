{
  "name": "@maxcolor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env --override -- tsx watch src/server.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env --override -- node dist/server.js",
    "db:push": "dotenv -e ../../.env --override -- prisma db push",
    "db:seed": "dotenv -e ../../.env --override -- tsx prisma/seed.ts",
    "test": "dotenv -e ../../.env --override -- prisma db push --skip-generate && dotenv -e ../../.env --override -- node --import tsx --test test/auth.test.ts test/health.test.ts test/produtos.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
